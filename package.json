{
  "name": "donly",
  "version": "0.0.12",
  "description": "DON (Directive Object Notation) - A human-readable data serialization format based on directives and subdirectives for configuration files, infrastructure definitions, and structured data",
  "keywords": [
    "don",
    "directive",
    "serialization",
    "parser",
    "config",
    "configuration",
    "data-format",
    "markup",
    "notation"
  ],
  "author": {
    "name": "Jonathan Delgado",
    "email": "hi@jon.soy",
    "url": "https://jon.soy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonDotsoy/don"
  },
  "homepage": "https://don.jon.soy/",
  "type": "module",
  "main": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./utils": {
      "types": "./lib/esm/utils/inspect.d.ts",
      "import": "./lib/esm/utils/inspect.js"
    },
    "./encoder": {
      "types": "./lib/esm/directive-json.d.ts",
      "import": "./lib/esm/directive-json.js"
    },
    "./decoder": {
      "types": "./lib/esm/directive-json.d.ts",
      "import": "./lib/esm/directive-json.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "prepack": "npm run docs && npm run lint && npm run build",
    "build": "npm run build:esm",
    "build:esm": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf lib",
    "lint": "prettier --check .",
    "fmt": "prettier --write .",
    "docs": "bun scripts/docs-generator/run.ts",
    "docs:spec": "bun scripts/spec-generator/run.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.7.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
